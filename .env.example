# ──────────────────────────────────────────────────
# EnvironmentStatus Monitor — example environment file
# Copy to .env and fill in real values before running.
# .env is gitignored; never commit it.
# ──────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development          # Set to "production" to enable secure cookies + strict sameSite

# Session (required when config.session = true)
SECRET=replace-with-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# InfluxDB (required when config.Influx = true)
INFLUXDB_TOKEN=
INFLUXDB_HOST=http://localhost:8086
